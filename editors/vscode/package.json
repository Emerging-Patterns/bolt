{
  "name": "bend-lsp",
  "displayName": "Bend",
  "description": "Bend 2: syntax highlighting, and the checker's errors through bend-lsp",
  "version": "0.1.5",
  "publisher": "ngngardner",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "bend",
        "aliases": [
          "Bend"
        ],
        "extensions": [
          ".bend"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bend",
        "scopeName": "source.bend",
        "path": "./syntaxes/bend.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bend",
      "properties": {
        "bend.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the bend-lsp binary. Empty: `bend-lsp` on PATH, then ~/.local/bin/bend-lsp."
        }
      }
    },
    "commands": [
      {
        "command": "bend.restartServer",
        "title": "Bend: Restart Language Server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
