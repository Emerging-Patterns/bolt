{
  "name": "Bend",
  "scopeName": "source.bend",
  "patterns": [
    {
      "name": "comment.line.documentation.bend",
      "match": "^#\\|.*$"
    },
    {
      "name": "comment.line.number-sign.bend",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.bend",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bend",
          "match": "\\\\(u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    {
      "name": "string.quoted.single.bend",
      "match": "'(\\\\(u[0-9a-fA-F]{4}|.)|[^'\\\\])'"
    },
    {
      "match": "^\\s*(import)\\s+(\\S+)(?:\\s+(as)\\s+([A-Za-z_][\\w.]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.import.bend"
        },
        "2": {
          "name": "string.unquoted.path.bend"
        },
        "3": {
          "name": "keyword.control.import.bend"
        },
        "4": {
          "name": "entity.name.namespace.bend"
        }
      }
    },
    {
      "match": "^\\s*(?:(@unsafe)\\s+)?(def|law)\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.bend"
        },
        "2": {
          "name": "keyword.declaration.bend"
        },
        "3": {
          "name": "entity.name.function.bend"
        }
      }
    },
    {
      "match": "^\\s*(type)\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.bend"
        },
        "2": {
          "name": "support.type.bend entity.name.type.bend"
        }
      }
    },
    {
      "name": "keyword.control.bend",
      "match": "\\b(match|case|do|return|for|exs|where|is|as)\\b"
    },
    {
      "name": "constant.language.bend",
      "match": "\\b(Type|Data|Kind|Quant)\\b|&[012]\\b"
    },
    {
      "name": "meta.hole.bend",
      "match": "\\?[A-Za-z_]\\w*"
    },
    {
      "name": "constant.numeric.bend",
      "match": "\\b\\d+(\\.\\d+)?n?\\b"
    },
    {
      "match": "\\b((?:[A-Z]\\w*\\.)*)([A-Z]\\w*)\\s*(?=\\{)",
      "captures": {
        "1": {
          "name": "support.type.bend"
        },
        "2": {
          "name": "variable.other.enummember.bend constant.other.enum.bend"
        }
      }
    },
    {
      "match": "\\b((?:[A-Z]\\w*\\.)*)([A-Za-z_][\\w.]*)(!?)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "support.type.bend"
        },
        "2": {
          "name": "entity.name.function.call.bend"
        },
        "3": {
          "name": "keyword.operator.gpu.bend"
        }
      }
    },
    {
      "name": "support.type.bend",
      "match": "\\b[A-Z]\\w*\\b"
    },
    {
      "name": "keyword.operator.bend",
      "match": "<-|->|=>|<>|\\+\\+|==|!=|<=|>=|&&|\\|\\||\\.&\\.|\\.\\|\\.|\\.\\^\\.|<<|>>|[-+*/%<>=~&|:]"
    }
  ]
}
