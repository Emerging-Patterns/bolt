#!/usr/bin/env bash
# bend-lint [--skip rule,rule] [file..]: lints the files given, or every
# .bend file under the current directory. A native Bend binary takes no
# arguments, so the list rides in BEND_LINT_FILES, one path a line, and the
# skipped rules in BEND_LINT_SKIP. Exits 1 when anything was found.
set -eu
bin="$(dirname "$(readlink -f "$0")")/../bin/bend-lint.bin"
skip=""
if [ "${1:-}" = "--skip" ]; then
  skip="$2"; shift 2
fi
if [ $# -eq 0 ]; then
  set -- $(find . -name '*.bend' -not -path '*/.gate/*' -not -path '*/node_modules/*' -not -path '*/.scratch/*' \
    -not -path '*/.claude/*' | sort)
fi
out=$(BEND_LINT_FILES="$(printf '%s\n' "$@")" BEND_LINT_SKIP="$skip" "$bin" --gpu off)
printf '%s\n' "$out"
[ "$out" = "clean" ]
