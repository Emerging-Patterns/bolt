#!/usr/bin/env bash
# bolt: the command line of the one binary, bin/bolt.bin.
#   bolt [lint] [file..]   lints the files, or every .bend file under the
#                          current directory, as the nearest bolt.bend of
#                          each asks; exits 1 when anything was an error
#   bolt check file..      the checker (bend) on each file, errors in the
#                          same shape; exits 1 when there were any
#   bolt lsp               the language server, over stdio
# A native Bend binary takes no arguments, so the subcommand rides in
# BOLT_CMD and the files in BOLT_FILES, one path a line.
set -eu
bin="$(dirname "$(readlink -f "$0")")/../bin/bolt.bin"
cmd=lint
case "${1:-}" in
  lint|check|lsp) cmd=$1; shift ;;
esac
if [ "$cmd" = lsp ]; then
  BOLT_CMD=lsp exec "$bin" --gpu off
fi
if [ $# -eq 0 ] && [ "$cmd" = lint ]; then
  set -- $(find . -name '*.bend' -not -path '*/.gate/*' -not -path '*/node_modules/*' -not -path '*/.scratch/*' \
    -not -path '*/.claude/*' | sort)
fi
out=$(BOLT_CMD=$cmd BOLT_FILES="$(printf '%s\n' "$@")" "$bin" --gpu off)
printf '%s\n' "$out"
case "$(printf '%s\n' "$out" | tail -n 1)" in
  clean|"0 errors"*) exit 0 ;;
  *) exit 1 ;;
esac
